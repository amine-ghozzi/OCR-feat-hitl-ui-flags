# FinAlze — copy to `.env` and FILL IN every empty value below.
#
#   cp .env.example .env
#
# Every variable in the REQUIRED block is declared `${VAR:?}` in docker-compose.yml.
# They are left EMPTY here on purpose: `:?` fires on empty as well as unset, so a
# verbatim copy of this file does NOT boot a stack — `docker compose config` stops at
# the first one it finds and names it. There is no placeholder to forget to change.
#
# `.env` is gitignored. Application settings are read by pydantic-settings with the
# FINALZE_ prefix (src/api/settings.py); a `/run/secrets/<field>` file wins over the
# env var when the stack is run with Docker/K8s file secrets.

# ==============================================================================
# REQUIRED — compose refuses to render while any of these is empty
# ==============================================================================

# Token/cookie signing secret; min 16 chars. This signs every access token: a shared
# or published value means anyone can forge an admin JWT. src/api/settings.py has no
# default for it, so the API also refuses to start without it.
#   openssl rand -hex 32
FINALZE_SECRET_KEY=

# Postgres superuser + database. Used by the postgres service AND by the
# FINALZE_DATABASE_URL DSN compose assembles from them.
#   openssl rand -hex 24        # for the password
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# RabbitMQ broker credentials (rabbitmq service + FINALZE_BROKER_URL).
#   openssl rand -hex 24
RABBITMQ_USER=
RABBITMQ_PASS=

# MinIO / S3 root credentials; the password must be at least 8 characters. Compose
# feeds the same pair to the minio service and to FINALZE_S3_ACCESS_KEY/SECRET_KEY.
#   openssl rand -hex 24
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Bootstrap administrator (src/api/bootstrap.py). The password must be at least 10
# characters (UserManager.validate_password). Avoid a reserved .local TLD —
# email-validator rejects it.
#   openssl rand -base64 18
FINALZE_ADMIN_EMAIL=
FINALZE_ADMIN_PASSWORD=

# Flower (celery monitor) HTTP basic auth, in `user:password` form — note the colon.
# Flower is loopback-bound too, but it exposes task arguments, so it is never open.
#   printf 'flower:%s\n' "$(openssl rand -hex 16)"
FLOWER_BASIC_AUTH=

# TLS for the single public port (8000). Absolute or compose-relative paths on the
# HOST; bind-mounted read-only into traefik, which refuses to start if either is
# missing. Generate a self-signed pair:
#   scripts/gen_selfsigned_cert.sh <host-or-ip>      # writes certs/server.{crt,key}
# A bank-provided certificate uses these same two variables. If it arrives as a leaf
# plus a separate intermediate/CA file, concatenate them LEAF FIRST into one PEM and
# point TRAEFIK_CERT_FILE at that — an incomplete chain is served without any error
# and is rejected by clients that do not already hold the intermediate.
TRAEFIK_CERT_FILE=
TRAEFIK_KEY_FILE=

# ==============================================================================
# OPTIONAL — every one of these is read by a container; compose supplies the
# default shown in brackets when the variable is absent.
# ==============================================================================

# OCR backend, worker only. Pinned to the engine the benchmark validated: Docling's
# auto-detection would pick EasyOCR and read scanned documents differently. [rapidocr]
FINALZE_OCR_ENGINE=rapidocr

# CORS origins — a JSON list STRING, parsed by pydantic as list[str]. Keep the JSON
# quoting. [["https://localhost:8000","http://localhost:8501"]]
FINALZE_ALLOWED_ORIGINS=["https://localhost:8000","http://localhost:8501"]

# Upload cap, megabytes. [25]
FINALZE_MAX_UPLOAD_MB=25

# Mount /docs and /redoc on the app. Traefik blocks those paths regardless (it routes
# by allowlist), so turning this on only helps on a developer machine. [false]
FINALZE_DOCS_ENABLED=false

# Accounting standard used when a request does not name one. [NCT]
FINALZE_DEFAULT_ACCOUNTING_STANDARD=NCT

# Object storage bucket and TLS-to-MinIO switch. [finalze-documents] [false]
FINALZE_S3_BUCKET=finalze-documents
FINALZE_S3_SECURE=false

# Learning log (GOV-4) — a FILE path, never inside the repo. A literal {org_id} is
# substituted with the tenant id (or "default"). Compose already points every
# container at the shared finalze_data volume; set this for local runs, probes,
# sweeps and benchmarks so they cannot write into the working tree.
FINALZE_VARIATION_LOG=/app/data/variation_candidates/{org_id}.jsonl

# UI credentials — a real service token or API key instead of the dev admin login.
# Leave empty to fall back to FINALZE_ADMIN_EMAIL/PASSWORD. [empty]
FINALZE_API_TOKEN=
FINALZE_API_KEY=

# ==============================================================================
# Running the API OUTSIDE compose (local dev / tests) — inside compose these are
# assembled from the credentials above and must NOT be set here.
# ==============================================================================
# FINALZE_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/finalze
# FINALZE_REDIS_URL=redis://localhost:6379/0
# FINALZE_BROKER_URL=amqp://user:pass@localhost:5672//
# FINALZE_RESULT_BACKEND_URL=redis://localhost:6379/1
# FINALZE_S3_ENDPOINT_URL=http://localhost:9000
# FINALZE_S3_ACCESS_KEY=
# FINALZE_S3_SECRET_KEY=
#
# FINALZE_ROOT_PATH is intentionally absent: the Traefik allowlist matches absolute
# paths, so a non-empty root_path makes the app unreachable through the proxy and
# re-exposes /metrics and /openapi.json under the new prefix. Changing it means
# rewriting traefik/dynamic.yml in the same commit.
