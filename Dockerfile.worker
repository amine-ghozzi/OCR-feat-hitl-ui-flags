# FinAlze worker image — heavy (full ML/extraction stack), non-root.
# Build is large (torch/docling/surya). Some ML wheels need build tools / system libs;
# add apt packages here if a dependency fails to install.
# syntax=docker/dockerfile:1
FROM python:3.13-slim AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/src PIP_NO_CACHE_DIR=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libgl1 libglib2.0-0 poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# constraints.txt = pip freeze of the verified dev venv: the image gets the SAME
# package versions the test suite + extraction benchmark validated. Without it,
# the `>=` floors drift on every build (a docling 2.70→2.101 drift broke
# `export_to_dataframe` → zero tables extracted in the container).
COPY requirements-worker.txt requirements.txt constraints.txt ./
RUN pip install --no-cache-dir -c constraints.txt -r requirements-worker.txt
# The worker persists to the same DB via the shared `api.models`, whose `User` table extends
# fastapi-users' base. fastapi-users is small/pure-python; kept as its own layer AFTER the heavy
# ML install so the multi-GB torch/surya layer stays cached when this is added/changed.
# onnxruntime: backend of RapidOCR — the VALIDATED FINALZE_OCR_ENGINE (rapidocr does not
# hard-depend on it; without it Tier 1 fails with "onnxruntime is not installed").
RUN pip install --no-cache-dir -c constraints.txt "fastapi-users[sqlalchemy]" "onnxruntime==1.23.2"

RUN useradd -m -u 10002 worker
COPY src/ /app/src/
USER worker

# Tier-1 worker on the default queue. A GPU worker on `-Q ocr.gpu` is added via the
# compose `gpu` profile when Tier-2 VLM lands. prefork + concurrency=1 for GPU-bound work.
CMD ["celery", "-A", "worker.celery_app", "worker", "-Q", "ocr.default", \
     "--pool=prefork", "--concurrency=1", "--loglevel=INFO"]
